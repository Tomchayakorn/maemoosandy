# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase (Project Settings → API Keys) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser.
# The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY (anon key) also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — SERVER ONLY, never NEXT_PUBLIC_.
# The legacy name SUPABASE_SERVICE_ROLE_KEY (service_role key) also works.
SUPABASE_SECRET_KEY=

# Public site URL (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ลิงก์แอดมินใน LINE push (ไม่ตั้ง = http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# แสดงปุ่มทดสอบบน /withdraw เฉพาะเมื่อ = true (ห้ามเปิดใน production)
# NEXT_PUBLIC_SHOW_TEST_CONTROLS=true

# LINE login via Supabase custom OIDC provider (Authentication → Providers → custom).
# Set to the provider id, e.g. custom:line. Leave empty to hide the LINE button.
NEXT_PUBLIC_LINE_PROVIDER_ID=

# ---- AI engine for readings ----
# claude (default) | gemini
AI_PROVIDER=claude

# ---- Anthropic Claude (default engine) ----
# Server only. From https://platform.claude.com → API Keys.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Google Gemini (only when AI_PROVIDER=gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (503/429/504) or times out.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# ---- Top-up: PromptPay QR (Phase 4) ----
# PromptPay ID (phone 0812345678 / national ID / e-wallet). When set, /topup shows a
# dynamic QR with the exact package amount. If empty, public/promptpay-qr.jpg is shown.
PROMPTPAY_ID=
# Name shown under the QR and used to verify slips (as the bank prints it), e.g. "นาง แซนดี้ ณ มัณตรา"
PROMPTPAY_RECEIVER_NAME=
# Account or PromptPay number to verify slips against (digits only are compared). Falls back to PROMPTPAY_ID.
PROMPTPAY_RECEIVER_ACCOUNT=

# ---- Top-up: slip verification (Phase 4) ----
# easyslip | slipok | mock (mock = accept any image as a correct payment; refused in production)
SLIP_PROVIDER=thunder   # thunder | easyslip | slipok | mock (dev only)
SLIP_API_KEY=
# SlipOK only: your branch id
SLIPOK_BRANCH_ID=
# Reject slips older than this many hours (default 24)
SLIP_MAX_AGE_HOURS=24

# Comma-separated admin emails allowed to open /admin/withdrawals (server-only)
ADMIN_EMAILS=

# LINE Messaging API push to the admin (server-only; optional): withdrawal requests, new credits, and ERROR alerts of the cat game / admin tools
# (src/lib/admin-alert.ts). Both values are needed; if either is missing nothing is sent and nothing breaks.
# LINE_CHANNEL_ACCESS_TOKEN = Messaging API channel → "Channel access token (long-lived)"; LINE_ADMIN_USER_ID = the admin's LINE user id (starts with U...)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
# Public LINE OA link for the green "notify admin" button (e.g. https://line.me/R/ti/p/@yourid)
NEXT_PUBLIC_LINE_OA_URL=

# Thunder Solution slip verification (SLIP_PROVIDER=thunder). Server-only.
THUNDER_API_KEY=
# Set to false to skip Thunder's own duplicate flag (our DB slip_ref UNIQUE still blocks reuse)
THUNDER_CHECK_DUPLICATE=true
# Shop receiving account (PromptPay phone / account digits and names as printed on slips)
SHOP_BANK_ACCOUNT_NO=
SHOP_BANK_ACCOUNT_NAME=
SHOP_BANK_ACCOUNT_NAME_EN=
